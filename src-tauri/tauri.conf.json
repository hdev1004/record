{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "화면 녹화",
  "mainBinaryName": "screen-recorder",
  "version": "1.0.0",
  "identifier": "com.local.screenrecorder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "화면 녹화",
        "url": "index.html",
        "width": 380,
        "height": 694,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
